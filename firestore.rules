rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if ownsUserDoc(uid);

      match /transactions/{transactionId} {
        allow read, delete: if ownsUserDoc(uid);
        allow create, update: if ownsUserDoc(uid)
          && request.resource.data.userId == uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense'];
      }

      match /budgets/{budgetId} {
        allow read, delete: if ownsUserDoc(uid);
        allow create, update: if ownsUserDoc(uid)
          && request.resource.data.userId == uid
          && request.resource.data.month is string
          && request.resource.data.limit is number
          && request.resource.data.limit >= 0;
      }

      match /settings/{settingId} {
        allow read, create, update, delete: if ownsUserDoc(uid);
      }
    }
  }
}
